APP_NAME=tao-ai-agent
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

ENABLE_REQUEST_LOGGING=true
ENABLE_METRICS=true
METRICS_PATH=/metrics
METRICS_COLLECT_INTERVAL_SECONDS=5
METRICS_TASK_STUCK_SECONDS=120
METRICS_TASK_LOOP_STEP_THRESHOLD=80

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:8b

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/agent_db?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_EMBEDDING_DIM=4096
MILVUS_CUSTOMER_FAQ_COLLECTION=customer_faq_collection
MILVUS_CUSTOMER_POLICY_COLLECTION=customer_policy_collection
MILVUS_WAREHOUSE_SOP_COLLECTION=warehouse_sop_collection
MILVUS_BUSINESS_RULES_COLLECTION=business_rules_collection
MILVUS_HISTORICAL_CASE_COLLECTION=historical_case_collection

LQZC_BASE_URL=http://localhost:8001
LQZC_CUSTOMER_TOKEN=
LQZC_ADMIN_TOKEN=

MCP_SERVER_URL=http://localhost:8001/mcp
MCP_PROTOCOL_VERSION=2025-06-18
MCP_TIMEOUT_SECONDS=20

RAG_TOP_K=4
MAX_AGENT_STEPS=8
ENABLE_APPROVAL=true
APPROVAL_ADMIN_TOKEN=
ENABLE_TRACE=true
ENABLE_EVAL=true
ENABLE_LLM_SUPERVISOR_ROUTER=true
LLM_SUPERVISOR_ROUTER_TIMEOUT_SECONDS=12

SKILLS_DIR=skills
SKILL_ROUTER_MAX_CANDIDATES=24
